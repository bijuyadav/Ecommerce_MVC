@model List<Category>
<h1>Category Section</h1>
<p></p>

<table class="table table-bordered table-striped">
    <thead>
    <tr>

        <th>
            Category Name
        </th>

        <th>
            Display Order
        </th>
        <th>
            History
        </th>

    </tr>
    </thead>

    <tbody>
        @foreach (var obj in Model)
        {
            <tr>
                <td>@obj.Name</td>
            <td>Display order</td>
            <td>History</td>
        </tr>}
    </tbody>

</table>
